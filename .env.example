# Local mode uses embedded PostgreSQL in .data. Never enabled on Vercel.
APP_ORIGIN=http://127.0.0.1:3000
# Configure for Neon later; do not commit credentials.
# DATABASE_URL=postgresql://...
# MIGRATION_DATABASE_URL=postgresql://...
# DATA_DIR=.data
# Password recovery: development writes .data/mail; deployed environments require email.
# RESEND_API_KEY=
# EMAIL_FROM=Quizzzz <hello@your-domain.example>
# ABLY_API_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
ROOM_CAPACITY=500
JOIN_IP_PER_MINUTE=1200

# Required before deploying live hosting. Local development generates an ignored secret.
# GAME_TOKEN_SECRET=at-least-32-random-characters
# APP_ENV=staging
# WORKFLOW_ENABLED=true
# CRON_SECRET=random-secret-for-protected-maintenance
JOIN_BROWSER_PER_MINUTE=20
JOIN_INVALID_PIN_PER_MINUTE=30
