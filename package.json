{
  "name": "quizzzz",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:load": "tsx scripts/load-http.ts",
    "test:cross-browser": "E2E_ALL_BROWSERS=true playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "format": "prettier --write src tests scripts next.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests scripts next.config.ts playwright.config.ts",
    "db:cleanup": "tsx scripts/cleanup.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "ably": "^2.29.0",
    "next": "16.4.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "workflow": "^5.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "overrides": {
    "nanoid": "^5.1.16",
    "devalue": "^5.9.3"
  }
}
